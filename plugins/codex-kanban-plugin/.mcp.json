        "CODEX_APP_TOOLS_PIPE_PATH",
        "CODEX_MCP_NODE_PATH"
      ],
      "startup_timeout_sec": 180,
      "tool_timeout_sec": 60,
      "env": {
        "TASKBOARD_BUILD_ID": "c7541a6898fa9b95313d2f5e28d9a2f0dc143379d63dcd7205d99e4ced2bbd79"
      }
    }
  }
}

{
  "mcpServers": {
    "codex-taskboard": {
      "command": "/bin/sh",
      "args": [
        "./scripts/start-mcp.sh"
      ],
      "cwd": ".",
      "env_vars": [
        "HOME",
        "PATH",
        "CODEX_HOME",
        "TASKBOARD_WS_URL",
        "TASKBOARD_SSH_SESSIONS",
        "TASKBOARD_SSH_ACTIONS",

{
  "mcpServers": {
    "codex-taskboard": {
      "command": "/bin/sh",
      "args": ["./scripts/start-mcp.sh", "dist/server/index.js"],
      "cwd": ".",
      "env_vars": [
        "HOME",
        "PATH",
        "CODEX_HOME",
        "TASKBOARD_WS_URL",
        "TASKBOARD_SSH_SESSIONS",
        "TASKBOARD_SSH_ACTIONS",
        "TASKBOARD_DESKTOP_CATALOG",
        "CODEX_APP_TOOLS_PIPE_PATH",
        "CODEX_MCP_NODE_PATH"
      ],
      "startup_timeout_sec": 180,
      "tool_timeout_sec": 60
    }
  }
}
